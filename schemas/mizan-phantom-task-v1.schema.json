{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aimenhamzi01-dot/phantom/blob/main/schemas/mizan-phantom-task-v1.schema.json",
  "title": "Mizan to Phantom signed task",
  "type": "object",
  "required": ["format", "task_id", "target", "target_type", "scope", "execution", "signature_algorithm", "signature"],
  "properties": {
    "format": {"const": "mizan-phantom-task-v1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "target": {"type": "string", "minLength": 1, "maxLength": 512},
    "target_type": {"enum": ["web", "code", "mobile", "hardware"]},
    "scope": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string"}},
    "execution": {
      "type": "object",
      "required": ["mode", "automatic_execution", "network_access_by_mizan", "max_duration_minutes", "result_format"],
      "properties": {
        "mode": {"const": "manual-handoff-only"},
        "automatic_execution": {"const": false},
        "network_access_by_mizan": {"const": false},
        "max_duration_minutes": {"const": 20},
        "result_format": {"const": "phantom-scan-result-v1"}
      },
      "additionalProperties": true
    },
    "signature_algorithm": {"const": "HMAC-SHA256"},
    "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
