# Meta Model API credentials. Keep this local and never commit .env.
# Mizan uses the same API family and Muse Spark model order.
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3,muse-spark-1.2,muse-spark-1.1
META_REASONING_EFFORT=high

# Shared with Mizan for signed task manifests.
MIZAN_PHANTOM_SIGNING_KEY=
PHANTOM_API_TOKEN=
PHANTOM_ALLOWED_TARGETS=https://authorized.example.com
PHANTOM_ALLOW_DIRECT_SCANS=false

SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
HOST=127.0.0.1
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
